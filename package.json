{
  "name": "esoa-to-wallet-budgetbakers",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first eSOA extraction and Wallet by BudgetBakers review workflow.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:watch": "vitest src",
    "eval": "node --import tsx scripts/evaluate.mjs",
    "eval:baseline": "node --import tsx scripts/evaluate.mjs",
    "benchmark": "node --import tsx scripts/benchmark.mjs",
    "demo": "echo 'Use the UI button: Load synthetic demo (offline, no Wallet). Or: POST /api/demo'",
    "audit": "npm audit --audit-level=high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:repository": "node scripts/check-sensitive-files.mjs",
    "scan:demo": "node scripts/check-demo-assets.mjs",
    "scan:external": "node scripts/check-external-origins.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run eval && npm run benchmark && npm run scan:secrets && npm run scan:repository && npm run scan:demo && npm run scan:external"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "csv-parse": "^7.0.2",
    "express": "^5.1.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.4",
    "tesseract.js": "6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
